<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AssemblyName>VisionWorkbenchLicenseIssuer</AssemblyName>
    <RootNamespace>VisionWorkbenchLicenseIssuer</RootNamespace>
    <Version>1.0.0</Version>
    <Company>VisionWorkbench</Company>
    <Product>VisionWorkbench License Issuer</Product>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\license-issuer-logo.png" />
  </ItemGroup>
</Project>
